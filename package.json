{
  "name": "version-compare",
  "displayName": "Version Compare",
  "description": "Compare two folders in VS Code with version/date-aware filename matching.",
  "version": "0.4.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuan88/version-compare.git"
  },
  "bugs": {
    "url": "https://github.com/shuan88/version-compare/issues"
  },
  "homepage": "https://github.com/shuan88/version-compare#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:versionCompare.results",
    "onCommand:versionCompare.selectLeftFolder",
    "onCommand:versionCompare.selectRightFolder",
    "onCommand:versionCompare.openCompareView",
    "onCommand:versionCompare.compare",
    "onCommand:versionCompare.refresh",
    "onCommand:versionCompare.changeSettingsAndRecompare",
    "onCommand:versionCompare.openDiff",
    "onCommand:versionCompare.openLeft",
    "onCommand:versionCompare.openRight",
    "onCommand:versionCompare.revealInExplorer",
    "onCommand:versionCompare.copyPaths",
    "onCommand:versionCompare.pickMatch",
    "onCommand:versionCompare.forceMatch",
    "onCommand:versionCompare.ignoreKey",
    "onCommand:versionCompare.exportJson",
    "onCommand:versionCompare.exportCsv",
    "onCommand:versionCompare.exportGptDebugPackage",
    "onCommand:versionCompare.askGptForRegex",
    "onCommand:versionCompare.importRegexConfig"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  },
  "contributes": {
    "commands": [
      {
        "command": "versionCompare.openCompareView",
        "title": "Version Compare: Open Compare View",
        "category": "Version Compare",
        "icon": "$(layout)"
      },
      {
        "command": "versionCompare.selectLeftFolder",
        "title": "Version Compare: Select Left Folder",
        "category": "Version Compare",
        "icon": "$(folder-opened)"
      },
      {
        "command": "versionCompare.selectRightFolder",
        "title": "Version Compare: Select Right Folder",
        "category": "Version Compare",
        "icon": "$(folder-opened)"
      },
      {
        "command": "versionCompare.compare",
        "title": "Version Compare: Compare",
        "category": "Version Compare",
        "icon": "$(compare-changes)"
      },
      {
        "command": "versionCompare.refresh",
        "title": "Version Compare: Refresh",
        "category": "Version Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "versionCompare.changeSettingsAndRecompare",
        "title": "Version Compare: Change Settings and Re-compare",
        "category": "Version Compare",
        "icon": "$(settings-gear)"
      },
      {
        "command": "versionCompare.openDiff",
        "title": "Open Diff",
        "category": "Version Compare",
        "icon": "$(diff)"
      },
      {
        "command": "versionCompare.openLeft",
        "title": "Open Left",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.openRight",
        "title": "Open Right",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.copyPaths",
        "title": "Copy Path(s)",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.pickMatch",
        "title": "Pick Match...",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.forceMatch",
        "title": "Force Match...",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.ignoreKey",
        "title": "Ignore this Key",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.exportJson",
        "title": "Export JSON Report...",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.exportCsv",
        "title": "Export CSV Report...",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.exportGptDebugPackage",
        "title": "Export GPT Debug Package...",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.askGptForRegex",
        "title": "Ask GPT for Regex Suggestions",
        "category": "Version Compare"
      },
      {
        "command": "versionCompare.importRegexConfig",
        "title": "Import Regex Config...",
        "category": "Version Compare"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "versionCompare.results",
          "name": "Version Compare"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "versionCompare.openCompareView",
          "when": "view == versionCompare.results",
          "group": "navigation@0"
        },
        {
          "command": "versionCompare.compare",
          "when": "view == versionCompare.results",
          "group": "navigation@1"
        },
        {
          "command": "versionCompare.refresh",
          "when": "view == versionCompare.results",
          "group": "navigation@2"
        },
        {
          "command": "versionCompare.changeSettingsAndRecompare",
          "when": "view == versionCompare.results",
          "group": "navigation@3"
        },
        {
          "command": "versionCompare.exportGptDebugPackage",
          "when": "view == versionCompare.results",
          "group": "navigation@4"
        },
        {
          "command": "versionCompare.askGptForRegex",
          "when": "view == versionCompare.results",
          "group": "navigation@5"
        },
        {
          "command": "versionCompare.importRegexConfig",
          "when": "view == versionCompare.results",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "versionCompare.openDiff",
          "when": "view == versionCompare.results && viewItem == paired",
          "group": "inline@1"
        },
        {
          "command": "versionCompare.pickMatch",
          "when": "view == versionCompare.results && viewItem == ambiguous",
          "group": "inline@1"
        },
        {
          "command": "versionCompare.forceMatch",
          "when": "view == versionCompare.results && viewItem =~ /leftOnly|rightOnly/",
          "group": "inline@1"
        },
        {
          "command": "versionCompare.openLeft",
          "when": "view == versionCompare.results && viewItem =~ /paired|leftOnly|error/",
          "group": "navigation@1"
        },
        {
          "command": "versionCompare.openRight",
          "when": "view == versionCompare.results && viewItem =~ /paired|rightOnly|error/",
          "group": "navigation@2"
        },
        {
          "command": "versionCompare.revealInExplorer",
          "when": "view == versionCompare.results && viewItem =~ /paired|leftOnly|rightOnly|error/",
          "group": "navigation@3"
        },
        {
          "command": "versionCompare.copyPaths",
          "when": "view == versionCompare.results && viewItem =~ /paired|leftOnly|rightOnly|ambiguous|error/",
          "group": "navigation@4"
        },
        {
          "command": "versionCompare.ignoreKey",
          "when": "view == versionCompare.results && viewItem =~ /paired|leftOnly|rightOnly|ambiguous/",
          "group": "z_ignore@1"
        }
      ],
      "commandPalette": [
        {
          "command": "versionCompare.openDiff",
          "when": "false"
        },
        {
          "command": "versionCompare.openLeft",
          "when": "false"
        },
        {
          "command": "versionCompare.openRight",
          "when": "false"
        },
        {
          "command": "versionCompare.revealInExplorer",
          "when": "false"
        },
        {
          "command": "versionCompare.copyPaths",
          "when": "false"
        },
        {
          "command": "versionCompare.pickMatch",
          "when": "false"
        },
        {
          "command": "versionCompare.forceMatch",
          "when": "false"
        },
        {
          "command": "versionCompare.ignoreKey",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Version Compare",
      "properties": {
        "versionCompare.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git/**",
            "**/.git/**",
            "node_modules/**",
            "**/node_modules/**",
            ".vscode/**",
            "**/.vscode/**",
            "**/*.tmp"
          ],
          "description": "Glob patterns excluded from both left and right scans."
        },
        "versionCompare.maxFiles": {
          "type": "number",
          "default": 50000,
          "minimum": 1,
          "description": "Maximum total file count allowed before the compare is stopped."
        },
        "versionCompare.matching.scope": {
          "type": "string",
          "enum": [
            "sameFolder",
            "anywhere"
          ],
          "default": "sameFolder",
          "description": "Whether matching is restricted to the same relative folder or can search globally."
        },
        "versionCompare.matching.includeTypePrefix": {
          "type": "boolean",
          "default": true,
          "description": "Include leading type prefixes such as G-RPT in the match key."
        },
        "versionCompare.matching.extPolicy": {
          "type": "string",
          "enum": [
            "sameExtOnly"
          ],
          "default": "sameExtOnly",
          "description": "Extension matching policy. v1 always requires identical extensions."
        },
        "versionCompare.matching.versionPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^(?:v|ver|version)?\\d+(?:\\.\\d+)*(?:p\\d+)?$",
            "^\\d+(?:\\.\\d+)*(?:[a-z]+\\d*)?$"
          ],
          "description": "Regex list used to identify version tokens near the end of a filename. Patterns are tested case-insensitively."
        },
        "versionCompare.matching.datePattern": {
          "type": "string",
          "default": "^\\d{8}$",
          "description": "Regex used to identify a trailing date token."
        },
        "versionCompare.matching.ignoreNamePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Regex patterns removed from the filename stem after type-prefix extraction and before tokenization. Use this to ignore specific characters or marker text during matching."
        },
        "versionCompare.matching.preset.ignoreParentheses": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore the characters ( and ) during filename matching."
        },
        "versionCompare.matching.preset.ignoreParenthesizedText": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore complete parenthesized text such as (old) or (reviewed)."
        },
        "versionCompare.matching.preset.ignoreSquareBrackets": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore the characters [ and ] during filename matching."
        },
        "versionCompare.matching.preset.ignoreBracketedText": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore complete bracketed text such as [old] or [reviewed]."
        },
        "versionCompare.matching.preset.ignoreHashMarks": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore # and full-width ＃ during filename matching."
        },
        "versionCompare.matching.preset.ignoreCopyMarkers": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore copy markers such as copy, 副本, 複本, and 拷貝."
        },
        "versionCompare.matching.preset.ignoreCommonNoiseWords": {
          "type": "boolean",
          "default": false,
          "description": "Preset regex: ignore draft/final/old/new and common Chinese version marker words. Use carefully because these words can be meaningful."
        },
        "versionCompare.disambiguation.strategy": {
          "type": "string",
          "enum": [
            "minDistanceGreedy",
            "latestOnEachSide",
            "manualPreferred"
          ],
          "default": "minDistanceGreedy",
          "description": "Strategy for matching multiple candidates within the same match key."
        },
        "versionCompare.disambiguation.ambiguityDeltaThreshold": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Minimum score gap required between the best pair and a competing pair before auto-pairing."
        },
        "versionCompare.disambiguation.versionMajorMismatchAsAmbiguous": {
          "type": "boolean",
          "default": false,
          "description": "Treat candidate pairs with different major versions as ambiguous."
        },
        "versionCompare.contentCompare": {
          "type": "string",
          "enum": [
            "size+hash",
            "size+mtime",
            "sizeOnly"
          ],
          "default": "size+hash",
          "description": "Method used to classify paired files as identical or modified."
        },
        "versionCompare.manualMatches": {
          "type": "object",
          "default": {},
          "description": "Manual match overrides keyed by match key or match key plus a suffix."
        },
        "versionCompare.ignoreKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Match keys ignored during compare."
        },
        "versionCompare.displayMode": {
          "type": "string",
          "enum": [
            "coreKey",
            "originalName"
          ],
          "default": "coreKey",
          "description": "Controls whether result labels prefer normalized core keys or original filenames."
        },
        "versionCompare.ai.endpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1/responses",
          "description": "AI API endpoint used by Ask GPT for Regex Suggestions. Can be an OpenAI endpoint or a company wrapper endpoint."
        },
        "versionCompare.ai.method": {
          "type": "string",
          "enum": [
            "POST",
            "PUT",
            "PATCH"
          ],
          "default": "POST",
          "description": "HTTP method for AI API requests."
        },
        "versionCompare.ai.model": {
          "type": "string",
          "default": "gpt-4.1",
          "description": "Model value inserted into the AI request body template."
        },
        "versionCompare.ai.apiKeyEnv": {
          "type": "string",
          "default": "OPENAI_API_KEY",
          "description": "Environment variable used for the API key when versionCompare.ai.apiKey is empty."
        },
        "versionCompare.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key. Prefer using versionCompare.ai.apiKeyEnv for security."
        },
        "versionCompare.ai.headersJson": {
          "type": "string",
          "default": "{\"Authorization\":\"Bearer {{apiKey}}\",\"Content-Type\":\"application/json\"}",
          "description": "JSON object template for AI request headers. Supports {{apiKey}}, {{model}}, and {{prompt}} placeholders."
        },
        "versionCompare.ai.bodyTemplateJson": {
          "type": "string",
          "default": "{\"model\":\"{{model}}\",\"input\":\"{{prompt}}\"}",
          "description": "JSON object template for the AI request body. Supports {{apiKey}}, {{model}}, and {{prompt}} placeholders."
        },
        "versionCompare.ai.responseTextPath": {
          "type": "string",
          "default": "output_text",
          "description": "Dot path to the text field in the AI API response. Common examples: output_text, choices.0.message.content."
        },
        "versionCompare.ai.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Timeout in milliseconds for AI API requests."
        }
      }
    }
  }
}
